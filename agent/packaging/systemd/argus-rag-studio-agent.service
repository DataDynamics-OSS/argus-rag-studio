[Unit]
Description=Argus RAG Studio Agent
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/argus-rag-studio-agent/bin/argus-rag-studio-agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=argus-rag-studio-agent

# Directories
RuntimeDirectory=argus-rag-studio-agent
StateDirectory=argus-rag-studio-agent
LogsDirectory=argus-rag-studio-agent
ConfigurationDirectory=argus-rag-studio-agent

[Install]
WantedBy=multi-user.target
