{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h"
  },
  "http": { "address": "0.0.0.0", "port": "5000" },
  "log": { "level": "info" },
  "extensions": {
    "search": { "enable": true },
    "ui": { "enable": true },
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://zot-build.example:5000"],
          "onDemand": false,
          "tlsVerify": false,
          "pollInterval": "1h",
          "content": [
            { "prefix": "argus/**" }
          ]
        }
      ]
    }
  }
}
