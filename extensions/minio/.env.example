# extensions/minio — 환경변수 예시 (cp .env.example .env 후 수정)

# 이미지(에어갭: 사내 zot 등으로 미러한 태그로 교체). :latest 금지 — 재현성/라이선스 명확화.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

# 자격증명 (RAG 백엔드 object_storage.access_key/secret_key 와 일치시킬 것)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# 포트
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
