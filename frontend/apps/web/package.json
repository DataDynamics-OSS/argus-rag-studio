{
  "name": "web",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "scripts": {
    "copy-wasm": "node -e \"require('fs').mkdirSync('public', { recursive: true }); require('fs').copyFileSync(require.resolve('@rhwp/core/rhwp_bg.wasm'), 'public/rhwp_bg.wasm')\"",
    "copy-pdf-worker": "node -e \"require('fs').mkdirSync('public', { recursive: true }); require('fs').copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'), 'public/pdf.worker.min.mjs')\"",
    "copy-assets": "pnpm copy-wasm && pnpm copy-pdf-worker",
    "predev": "pnpm copy-assets",
    "prebuild": "pnpm copy-assets",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dicebear/core": "^10.1.0",
    "@dicebear/styles": "^10.1.0",
    "@hookform/resolvers": "^5.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@rhwp/core": "0.7.18",
    "@tanstack/react-table": "^8.21.3",
    "@workspace/ui": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "exifr": "^7.1.3",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.15.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  }
}
